const ID_TITLES = {
  name: ['Фамилия и имя', 'Имя и фамилия'],
  group: ['Класс/группа'],
  email: ['Email родителя'],
};

function createAll() {
  const props = PropertiesService.getScriptProperties();
  const ss = getSpreadsheet_(props);
  FORMS_DATA.forEach(function (data) {
    const id = formId_(ss, props, data.key);
    if (!id) {
      const form = buildForm_(data);
      form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
      props.setProperty('form-' + data.key, form.getId());
      SpreadsheetApp.flush();
      renameResponseSheet_(ss, form, data.key);
      Logger.log('Создана форма ' + data.key + ' (' + maxPointsOfData_(data) + ' баллов)');
    } else {
      Logger.log('Уже есть форма ' + data.key + ', пропускаю');
    }
  });
  writeLinks_(ss, props);
  Logger.log('Готово. Таблица: ' + ss.getUrl());
}

// Забыть созданные формы (сами формы и таблица останутся на Диске).
function forgetAll() {
  PropertiesService.getScriptProperties().deleteAllProperties();
  Logger.log('Забыл созданные формы. Следующий createAll создаст новые.');
}

// Меню в таблице. Работает, если код вставлен через «Расширения» → «Apps Script».
function onOpen() {
  try {
    SpreadsheetApp.getUi().createMenu('Памятьвиль')
      .addItem('Обновить оценки', 'refreshGrades')
      .addItem('Отправить оценки родителям', 'sendGrades')
      .addToUi();
  } catch (e) { /* запуск не из таблицы */ }
}

function buildForm_(data) {
  const form = FormApp.create(data.title);
  form.setTitle(data.title)
    .setDescription(data.description)
    .setIsQuiz(true)
    .setCollectEmail(false)
    .setProgressBar(true)
    .setShuffleQuestions(true)
    .setAllowResponseEdits(false)
    .setShowLinkToRespondAgain(false)
    .setConfirmationMessage(data.identity === 'parent'
      ? 'Ответы отправлены. Учитель проверит развёрнутые ответы, и оценка придёт родителям на почту.'
      : 'Готово! Бит Байт доволен. Баллы покажет учитель.');
  try { form.setRequireLogin(false); } catch (e) { /* только для Google Workspace */ }

  // Данные ученика в отдельном первом разделе, чтобы перемешивание их не трогало.
  if (data.identity === 'parent') {
    form.addTextItem().setTitle(ID_TITLES.name[0]).setHelpText('Например: Иванов Иван').setRequired(true);
    form.addTextItem().setTitle(ID_TITLES.group[0]).setHelpText('Например: 7Б или группа «Среда 16:00»').setRequired(true);
    form.addTextItem().setTitle(ID_TITLES.email[0])
      .setHelpText('На этот адрес учитель отправит оценку. Проверь, что адрес без ошибок.')
      .setRequired(true)
      .setValidation(FormApp.createTextValidation()
        .setHelpText('Нужен адрес почты, например mama@gmail.com')
        .requireTextIsEmail()
        .build());
  } else {
    form.addTextItem().setTitle(ID_TITLES.name[1]).setRequired(true);
  }
  form.addPageBreakItem().setTitle('Вопросы').setHelpText('Порядок вопросов у каждого свой.');

  data.questions.forEach(function (it) {
    if (it.t === 'open') {
      const p = form.addParagraphTextItem().setTitle(it.q);
      if (it.pts) {
        p.setRequired(true).setPoints(it.pts)
          .setHelpText('Развёрнутый ответ, проверяет учитель. До ' + it.pts + ' ' + pointsWord_(it.pts) + '.');
      } else {
        p.setRequired(false);
      }
      return;
    }
    const right = [].concat(it.a);
    const all = shuffle_(right.concat(it.wrong));
    const item = it.t === 'many' ? form.addCheckboxItem() : form.addMultipleChoiceItem();
    item.setTitle(it.q)
      .setRequired(true)
      .setPoints(it.pts || 1)
      .setChoices(all.map(function (c) { return item.createChoice(c, right.indexOf(c) >= 0); }));
    if (it.why) {
      item.setFeedbackForCorrect(FormApp.createFeedback().setText('Верно! ' + it.why).build());
      item.setFeedbackForIncorrect(FormApp.createFeedback().setText(it.why).build());
    }
  });
  return form;
}

// ---------- Оценки ----------

// Процент баллов → школьная оценка по порогам из GRADES.thresholds.
function gradeFor_(percent) {
  const t = GRADES.thresholds;
  if (percent >= t[5]) return 5;
  if (percent >= t[4]) return 4;
  if (percent >= t[3]) return 3;
  return 2;
}

function percentOf_(score, max) {
  return max > 0 ? Math.round(score / max * 1000) / 10 : 0;
}

const GRADE_HEADER = ['Ключ', 'Тест', 'Фамилия и имя', 'Класс/группа', 'Email родителя',
  'Баллы', 'Макс', '%', 'Оценка', 'Открытые ответы', 'Проверил учитель', 'Отправлено',
  'Примечание', 'Время ответа', 'ID ответа'];
const COL = {};
GRADE_HEADER.forEach(function (h, i) { COL[h] = i; });

// Собирает лист «Оценки» заново по ответам из форм. Галочки «Проверил учитель»
// и отметки «Отправлено» сохраняются. Запускай после ручной проверки в формах.
function refreshGrades() {
  const props = PropertiesService.getScriptProperties();
  const ss = getSpreadsheet_(props);
  let sh = ss.getSheetByName(GRADES.sheetName);
  if (!sh) sh = ss.insertSheet(GRADES.sheetName);

  const kept = {};
  if (sh.getLastRow() > 1) {
    sh.getRange(2, 1, sh.getLastRow() - 1, GRADE_HEADER.length).getValues().forEach(function (r) {
      const rid = r[COL['ID ответа']];
      if (rid) kept[rid] = { checked: r[COL['Проверил учитель']] === true, sent: r[COL['Отправлено']] };
    });
  }

  const rows = [];
  FORMS_DATA.forEach(function (data) {
    const id = formId_(ss, props, data.key);
    if (!id) return;
    const form = FormApp.openById(id);
    gradeRows_(data, form, kept).forEach(function (r) { rows.push(r); });
  });

  sh.clear();
  sh.getRange(1, 1, 1, GRADE_HEADER.length).setValues([GRADE_HEADER]).setFontWeight('bold');
  sh.setFrozenRows(1);
  if (rows.length) {
    sh.getRange(2, 1, rows.length, GRADE_HEADER.length).setValues(rows);
    sh.getRange(2, COL['Проверил учитель'] + 1, rows.length, 1).insertCheckboxes();
    sh.getRange(2, COL['Проверил учитель'] + 1, rows.length, 1)
      .setValues(rows.map(function (r) { return [r[COL['Проверил учитель']]]; }));
  }
  Logger.log('Оценки обновлены: ' + rows.length + ' строк.');
  return rows.length;
}

// Строки листа «Оценки» для одной формы.
function gradeRows_(data, form, kept) {
  const info = formPoints_(form);
  const rows = [];
  form.getResponses().forEach(function (resp) {
    const who = identity_(resp);
    let score = 0;
    let pending = 0;
    resp.getGradableItemResponses().forEach(function (ir) {
      const s = ir.getScore();
      const itemId = ir.getItem().getId();
      if (info.openIds.indexOf(itemId) >= 0) {
        const answered = String(ir.getResponse() || '').trim() !== '';
        if (answered && (s === null || s === undefined || s === '')) pending++;
      }
      score += Number(s) || 0;
    });
    const rid = resp.getId();
    const old = kept[rid] || {};
    const pct = percentOf_(score, info.max);
    let openState = 'нет';
    if (info.openIds.length) openState = pending ? 'нужно проверить (' + pending + ')' : 'есть, баллы стоят';
    rows.push([data.key, data.title, who.name, who.group, who.email,
      score, info.max, pct, gradeFor_(pct), openState, old.checked === true, old.sent || '',
      '', resp.getTimestamp(), rid]);
  });
  markRepeats_(rows);
  return rows;
}

// Если ученик сдал одну форму несколько раз, в письмо идёт только последняя попытка.
function markRepeats_(rows) {
  const last = {};
  rows.forEach(function (r, i) {
    const k = r[COL['Ключ']] + '|' + norm_(r[COL['Фамилия и имя']]) + '|' + norm_(r[COL['Email родителя']]);
    if (last[k] === undefined || r[COL['Время ответа']] >= rows[last[k]][COL['Время ответа']]) last[k] = i;
  });
  const keep = {};
  Object.keys(last).forEach(function (k) { keep[last[k]] = true; });
  rows.forEach(function (r, i) {
    if (!keep[i]) r[COL['Примечание']] = 'Есть более поздняя попытка, письмо не шлётся';
  });
}

// Максимум баллов и id развёрнутых вопросов с баллами прямо из формы.
function formPoints_(form) {
  const T = FormApp.ItemType;
  let max = 0;
  const openIds = [];
  form.getItems().forEach(function (it) {
    let pts = 0;
    switch (it.getType()) {
      case T.MULTIPLE_CHOICE: pts = it.asMultipleChoiceItem().getPoints(); break;
      case T.CHECKBOX: pts = it.asCheckboxItem().getPoints(); break;
      case T.LIST: pts = it.asListItem().getPoints(); break;
      case T.TEXT: pts = it.asTextItem().getPoints(); break;
      case T.PARAGRAPH_TEXT:
        pts = it.asParagraphTextItem().getPoints();
        if (pts > 0) openIds.push(it.getId());
        break;
      default: pts = 0;
    }
    max += pts || 0;
  });
  return { max: max, openIds: openIds };
}

function identity_(resp) {
  const who = { name: '', group: '', email: '' };
  resp.getItemResponses().forEach(function (ir) {
    const title = ir.getItem().getTitle();
    const val = String(ir.getResponse() || '').trim();
    Object.keys(ID_TITLES).forEach(function (k) {
      if (ID_TITLES[k].indexOf(title) >= 0) who[k] = val;
    });
  });
  return who;
}

// Отправляет родителям оценки, которые ещё не отправлялись. Одно письмо на
// один адрес, в нём все новые результаты. Сначала обновляет лист «Оценки».
function sendGrades() {
  refreshGrades();
  const ss = getSpreadsheet_(PropertiesService.getScriptProperties());
  const sh = ss.getSheetByName(GRADES.sheetName);
  const n = sh.getLastRow() - 1;
  if (n < 1) { report_('Ответов пока нет.'); return; }
  const values = sh.getRange(2, 1, n, GRADE_HEADER.length).getValues();

  const byEmail = {};
  const order = [];
  let waiting = 0;
  let noEmail = 0;
  values.forEach(function (r, i) {
    const pick = sendable_(r);
    if (pick === 'wait') { waiting++; return; }
    if (pick === 'noemail') { noEmail++; return; }
    if (pick !== 'ok') return;
    const email = norm_(r[COL['Email родителя']]);
    if (!byEmail[email]) { byEmail[email] = []; order.push(email); }
    byEmail[email].push(i);
  });

  let sent = 0;
  let left = 0;
  for (let k = 0; k < order.length; k++) {
    const email = order[k];
    if (MailApp.getRemainingDailyQuota() < 1) { left = order.length - k; break; }
    const items = byEmail[email].map(function (i) { return values[i]; });
    const letter = buildLetter_(items);
    MailApp.sendEmail({ to: email, subject: letter.subject, body: letter.body, name: GRADES.courseName });
    const stamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd.MM.yyyy HH:mm');
    byEmail[email].forEach(function (i) {
      sh.getRange(i + 2, COL['Отправлено'] + 1).setValue(stamp);
    });
    sent++;
  }
  let msg = 'Отправлено писем: ' + sent + '.';
  if (left) msg += ' Закончился дневной лимит почты. Адресов в очереди: ' + left + ', они уйдут при следующем запуске.';
  if (waiting) msg += ' Ждут галочки «Проверил учитель»: ' + waiting + '.';
  if (noEmail) msg += ' Без корректного email родителя: ' + noEmail + '.';
  report_(msg);
  return sent;
}

// 'ok' можно отправлять, 'wait' ждёт проверки учителя, 'noemail' нет адреса, 'skip' не нужно.
function sendable_(r) {
  if (r[COL['Отправлено']]) return 'skip';
  if (r[COL['Примечание']]) return 'skip';
  const email = norm_(r[COL['Email родителя']]);
  const data = FORMS_DATA.filter(function (d) { return d.key === r[COL['Ключ']]; })[0];
  if (!email && !(data && data.identity === 'parent')) return 'skip'; // старые формы без email
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return 'noemail';
  if (r[COL['Открытые ответы']] !== 'нет' && r[COL['Проверил учитель']] !== true) return 'wait';
  return 'ok';
}

function buildLetter_(rows) {
  const name = rows[0][COL['Фамилия и имя']] || 'ученик';
  const group = rows[0][COL['Класс/группа']];
  const t = GRADES.thresholds;
  const lines = [
    'Здравствуйте!',
    '',
    'Результаты: ' + name + (group ? ' (' + group + ')' : '') + ', курс «' + GRADES.courseName + '».',
    '',
  ];
  rows.forEach(function (r) {
    lines.push('- ' + r[COL['Тест']] + ': ' + r[COL['Баллы']] + ' из ' + r[COL['Макс']] +
      ' баллов (' + String(r[COL['%']]).replace('.', ',') + ' %), оценка ' + r[COL['Оценка']] + '.');
    if (r[COL['Открытые ответы']] !== 'нет') lines.push('  Развёрнутые ответы проверил учитель.');
  });
  lines.push('');
  lines.push('Оценка ставится по доле набранных баллов: от ' + t[5] + ' % «5», от ' + t[4] +
    ' % «4», от ' + t[3] + ' % «3», ниже «2».');
  lines.push('Если есть вопросы, просто ответьте на это письмо.');
  lines.push('');
  lines.push('С уважением,');
  lines.push(GRADES.signature);
  return {
    subject: GRADES.courseName + ': результаты, ' + name,
    body: lines.join('\n'),
  };
}

function report_(msg) {
  Logger.log(msg);
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { /* запуск из редактора */ }
}

// ---------- Служебное ----------

function getSpreadsheet_(props) {
  try {
    const active = SpreadsheetApp.getActiveSpreadsheet();
    if (active) {
      props.setProperty('sheet', active.getId());
      return active;
    }
  } catch (e) { /* отдельный проект без таблицы */ }
  const id = props.getProperty('sheet');
  if (id) {
    try { return SpreadsheetApp.openById(id); } catch (e) { /* таблицу удалили */ }
  }
  const ss = SpreadsheetApp.create(SHEET_NAME);
  props.setProperty('sheet', ss.getId());
  return ss;
}

// id формы по ключу: из настроек скрипта или по листу ответов с именем ключа.
function formId_(ss, props, key) {
  const saved = props.getProperty('form-' + key);
  if (saved && exists_(saved)) return saved;
  const sh = ss.getSheetByName(key);
  const url = sh && sh.getFormUrl();
  if (url) {
    try {
      const id = FormApp.openByUrl(url).getId();
      props.setProperty('form-' + key, id);
      return id;
    } catch (e) { /* форму удалили */ }
  }
  return null;
}

function renameResponseSheet_(ss, form, key) {
  if (ss.getSheetByName(key)) return;
  ss.getSheets().forEach(function (sh) {
    const f = sh.getFormUrl();
    if (!f) return;
    try {
      if (FormApp.openByUrl(f).getId() === form.getId()) sh.setName(key);
    } catch (e) { /* лист от удалённой формы */ }
  });
}

function writeLinks_(ss, props) {
  let sh = ss.getSheetByName('Ссылки');
  if (!sh) sh = ss.insertSheet('Ссылки', 0);
  sh.clear();
  const rows = [['Ключ', 'Название', 'Ссылка для учеников', 'Редактировать']];
  const lines = [];
  FORMS_DATA.forEach(function (data) {
    const id = props.getProperty('form-' + data.key);
    if (!id) return;
    const form = FormApp.openById(id);
    const url = form.getPublishedUrl();
    rows.push([data.key, data.title, url, form.getEditUrl()]);
    lines.push("  '" + data.key + "': '" + url + "',");
  });
  // По строке в ячейке и одинарные кавычки: при копировании диапазона Таблицы
  // не добавляют свои кавычки и не удваивают наши, файл вставляется как есть.
  const block = ['// Вставь эти строки в assets/js/forms.js', 'window.FORMS = {'].concat(lines, ['};']);
  sh.getRange(1, 1, block.length, 1).setValues(block.map(function (l) { return [l]; })).setFontFamily('Courier New');
  const top = block.length + 2;
  sh.getRange(top, 1, rows.length, rows[0].length).setValues(rows);
  sh.getRange(top, 1, 1, rows[0].length).setFontWeight('bold');
  sh.setColumnWidth(1, 420);
}

function maxPointsOfData_(data) {
  return data.questions.reduce(function (s, it) {
    if (it.t === 'open') return s + (it.pts || 0);
    return s + (it.pts || 1);
  }, 0);
}

function pointsWord_(n) {
  const d = n % 10, h = n % 100;
  if (d === 1 && h !== 11) return 'балла';
  return 'баллов';
}

function norm_(s) {
  return String(s || '').trim().toLowerCase().replace(/ё/g, 'е').replace(/\s+/g, ' ');
}

function exists_(id) {
  try { FormApp.openById(id); return true; } catch (e) { return false; }
}

function shuffle_(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
}
